{
  "version": 1,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48
      },
      "rules": {
        "minItems": 1,
        "maxItems": 6,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "trigger": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "enemy_died"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "enemy_spawned"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "player_damaged"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "wave_started"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "interval"
                    },
                    "everyMs": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 60000
                    }
                  },
                  "required": [
                    "type",
                    "everyMs"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "filters": {
              "default": [],
              "maxItems": 4,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "enemy_type"
                      },
                      "value": {
                        "type": "string",
                        "enum": [
                          "hover-drone",
                          "skitter",
                          "hauler"
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "tag"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32,
                        "pattern": "^[a-z][a-z0-9_-]*$"
                      }
                    },
                    "required": [
                      "type",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "chance"
                      },
                      "value": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "type",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "health_below"
                      },
                      "percent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "type",
                      "percent"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "actions": {
              "minItems": 1,
              "maxItems": 3,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "spawn"
                      },
                      "enemyType": {
                        "type": "string",
                        "enum": [
                          "hover-drone",
                          "skitter",
                          "hauler"
                        ]
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4
                      },
                      "at": {
                        "type": "object",
                        "properties": {
                          "anchor": {
                            "type": "string",
                            "enum": [
                              "event",
                              "player",
                              "arena"
                            ]
                          },
                          "radius": {
                            "default": 0,
                            "type": "number",
                            "minimum": 0,
                            "maximum": 400
                          }
                        },
                        "required": [
                          "anchor"
                        ],
                        "additionalProperties": false
                      },
                      "profile": {
                        "type": "object",
                        "properties": {
                          "health": {
                            "default": 1,
                            "type": "number",
                            "minimum": 0.25,
                            "maximum": 3
                          },
                          "speed": {
                            "default": 1,
                            "type": "number",
                            "minimum": 0.5,
                            "maximum": 1.5
                          },
                          "damage": {
                            "default": 1,
                            "type": "number",
                            "minimum": 0.25,
                            "maximum": 2
                          },
                          "size": {
                            "default": 1,
                            "type": "number",
                            "minimum": 0.4,
                            "maximum": 1.5
                          },
                          "reward": {
                            "default": 0.5,
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },
                        "additionalProperties": false
                      },
                      "tags": {
                        "default": [],
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 32,
                          "pattern": "^[a-z][a-z0-9_-]*$"
                        }
                      }
                    },
                    "required": [
                      "type",
                      "enemyType",
                      "count",
                      "at",
                      "profile"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "explode"
                      },
                      "at": {
                        "type": "object",
                        "properties": {
                          "anchor": {
                            "type": "string",
                            "enum": [
                              "event",
                              "player",
                              "arena"
                            ]
                          },
                          "radius": {
                            "default": 0,
                            "type": "number",
                            "minimum": 0,
                            "maximum": 400
                          }
                        },
                        "required": [
                          "anchor"
                        ],
                        "additionalProperties": false
                      },
                      "radius": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 120
                      },
                      "damage": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 30
                      }
                    },
                    "required": [
                      "type",
                      "at",
                      "radius",
                      "damage"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "modify"
                      },
                      "target": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "player"
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "event_entity"
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "enemies"
                              },
                              "enemyType": {
                                "type": "string",
                                "enum": [
                                  "hover-drone",
                                  "skitter",
                                  "hauler"
                                ]
                              },
                              "tag": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 32,
                                "pattern": "^[a-z][a-z0-9_-]*$"
                              },
                              "area": {
                                "type": "object",
                                "properties": {
                                  "at": {
                                    "type": "object",
                                    "properties": {
                                      "anchor": {
                                        "type": "string",
                                        "enum": [
                                          "event",
                                          "player",
                                          "arena"
                                        ]
                                      },
                                      "radius": {
                                        "default": 0,
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 400
                                      }
                                    },
                                    "required": [
                                      "anchor"
                                    ],
                                    "additionalProperties": false
                                  },
                                  "radius": {
                                    "type": "number",
                                    "minimum": 30,
                                    "maximum": 600
                                  }
                                },
                                "required": [
                                  "at",
                                  "radius"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "stat": {
                        "type": "string",
                        "enum": [
                          "move_speed",
                          "projectile_damage",
                          "attack_interval",
                          "contact_damage",
                          "size"
                        ]
                      },
                      "multiplier": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2
                      },
                      "durationMs": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "wave"
                          },
                          {
                            "type": "integer",
                            "minimum": 250,
                            "maximum": 15000
                          }
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "target",
                      "stat",
                      "multiplier",
                      "durationMs"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "cooldownMs": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 60000
            }
          },
          "required": [
            "id",
            "trigger",
            "actions"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "name",
      "rules"
    ],
    "additionalProperties": false
  },
  "triggers": {
    "enemy_died": {
      "enemy": true,
      "position": true,
      "liveEntity": null
    },
    "enemy_spawned": {
      "enemy": true,
      "position": true,
      "liveEntity": "enemy"
    },
    "player_damaged": {
      "enemy": false,
      "position": true,
      "liveEntity": "player"
    },
    "wave_started": {
      "enemy": false,
      "position": false,
      "liveEntity": null
    },
    "interval": {
      "enemy": false,
      "position": false,
      "liveEntity": null
    }
  },
  "filters": [
    {
      "type": "enemy_type",
      "requiresEnemyEvent": true
    },
    {
      "type": "tag",
      "requiresEnemyEvent": true
    },
    {
      "type": "chance",
      "requiresEnemyEvent": false
    },
    {
      "type": "health_below",
      "requiresEnemyEvent": false
    }
  ],
  "selectors": [
    "player",
    "event_entity",
    "enemies"
  ],
  "anchors": [
    "event",
    "player",
    "arena"
  ],
  "actions": {
    "spawn": {
      "perUnit": 3
    },
    "explode": {
      "fixed": 5
    },
    "modify": {
      "fixed": 1
    }
  },
  "enemyKinds": [
    "hover-drone",
    "skitter",
    "hauler"
  ],
  "stats": {
    "player": [
      "move_speed",
      "projectile_damage",
      "attack_interval"
    ],
    "enemy": [
      "move_speed",
      "contact_damage",
      "size"
    ],
    "bounds": {
      "move_speed": {
        "player": [
          100,
          460
        ],
        "enemy": [
          25,
          280
        ]
      },
      "projectile_damage": {
        "player": [
          3,
          180
        ]
      },
      "attack_interval": {
        "player": [
          100,
          1200
        ]
      },
      "contact_damage": {
        "enemy": [
          2,
          45
        ]
      },
      "size": {
        "enemy": [
          0.4,
          2
        ]
      }
    }
  },
  "limits": {
    "rules": 6,
    "actions": 3,
    "filters": 4,
    "tags": 4,
    "pending": 64,
    "events": 128,
    "actionsPerEvent": 18,
    "actionsPerFrame": 24,
    "eventsPerFrame": 128,
    "chainDepth": 4,
    "waveSpawns": 48,
    "chaos": 32,
    "arenaMargin": 80,
    "burst": 32,
    "refillPerSecond": 8,
    "warningMs": 750,
    "jsonCharacters": 32000,
    "offspringGenerations": 1
  },
  "entityLimits": {
    "enemies": 70,
    "projectiles": 48,
    "pickups": 140,
    "warnings": 8,
    "effects": 60
  },
  "runtimeChecks": [
    "unique_rule_ids",
    "unique_tags",
    "trigger_filter_context",
    "trigger_placement_context",
    "live_entity_context",
    "target_stat_compatibility",
    "total_action_cost"
  ],
  "lifecycle": {
    "queue": "one_next_wave_slot",
    "activation": "before_wave_started",
    "expiration": "before_shutdown_payout",
    "modifierIdentity": [
      "owner",
      "rule",
      "action",
      "target",
      "stat"
    ],
    "retrigger": "refresh",
    "pause": "freeze_gameplay_time",
    "offspringGenerations": 1,
    "sourceIdentity": "application_owned",
    "terminal": [
      "death",
      "restart"
    ],
    "validation": "JSON Schema describes structure; validateRuleset must approve the complete composition before queueing."
  }
}
